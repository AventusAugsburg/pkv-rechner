<!DOCTYPE html>
<html lang="de" class="h-full bg-[#030039]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PKV-Analyse · Beamtenhelden</title>
  <meta name="description" content="Deine kostenlose PKV-Analyse in 2 Minuten – direkt per WhatsApp oder E-Mail." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700;900&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brandDark: '#030039',
            brandAccent: '#00bd9e',
            brandButton: '#2200c8'
          },
          fontFamily: {
            sans: ['"Source Sans 3"', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    .step-enter { animation: slideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes slideIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="font-sans text-white min-h-full flex flex-col justify-between antialiased selection:bg-brandAccent selection:text-brandDark">

  <nav id="nav" class="sticky top-0 z-50 transition-all duration-300 border-b border-white/5 bg-brandDark/80 backdrop-blur-md py-4">
    <div class="max-w-3xl mx-auto px-4 flex items-center justify-between">
      <span class="font-black text-xl tracking-tight">BEAMTEN<span class="text-brandAccent">HELDEN</span></span>
      <div id="progress-container" class="w-1/2 bg-white/10 h-2 rounded-full overflow-hidden hidden">
        <div id="progress-bar" class="bg-brandAccent h-full w-0 transition-all duration-500 ease-out"></div>
      </div>
    </div>
  </nav>

  <main class="flex-grow flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-xl bg-white/5 border border-white/10 rounded-3xl p-6 md:p-8 shadow-2xl backdrop-blur-xl relative overflow-hidden">
      
      <div id="funnel-container" class="step-enter">
        </div>

    </div>
  </main>

  <footer class="py-6 border-t border-white/5 text-center text-xs text-white/40">
    <div class="max-w-3xl mx-auto px-4 flex justify-between items-center">
      <p>&copy; 2026 Aventus AG · Beamtenhelden</p>
      <div id="lead-badge" class="bg-brandAccent/10 border border-brandAccent/20 text-brandAccent px-3 py-1 rounded-full font-mono text-[10px]">
        Leads lokal: <span id="badge-count">0</span>
      </div>
    </div>
  </footer>

  <script>
    // 1. Konfiguration & Setup
    const CONFIG = {
      webhookUrl: 'https://dein-backend-oder-make-webhook.com/lead', // Hier die echte URL rein
      whatsappNumber: '49176XXXXXXXX' // Hier die Zielnummer ohne "+" eintragen
    };

    // 2. Definition des Fragen-Flows (Datenmodell)
    const FLOW_STEPS = [
      {
        id: 'start',
        type: 'start',
        title: 'Deine private Krankenversicherung',
        subtitle: 'Finde in weniger als 2 Minuten heraus, wie viel du als Beamter oder Anwärter sparen kannst.',
        buttonText: 'Jetzt Analyse starten'
      },
      {
        id: 'status',
        type: 'select',
        title: 'Wie ist dein aktueller beruflicher Status?',
        key: 'berufsstatus',
        options: [
          { value: 'anwaerter', label: 'Beamtenanwärter / Referendar', desc: 'Sonderkonditionen für den Einstieg' },
          { value: 'lebenszeit', label: 'Beamter auf Lebenszeit / Probe', desc: 'Optimierung bestehender Tarife' },
          { value: 'angestellt', label: 'Angestellter im öfftl. Dienst', desc: 'Prüfung der Systemalternative' }
        ]
      },
      {
        id: 'beihilfe',
        type: 'select',
        title: 'Hast du Anspruch auf Beihilfe?',
        key: 'beihilfe_anspruch',
        options: [
          { value: 'ja', label: 'Ja, ich habe Beihilfeanspruch', desc: 'In der Regel 50% bis 70%' },
          { value: 'nein', label: 'Nein / Ich bin unsicher', desc: 'Wir prüfen deinen Anspruch vorab' }
        ]
      },
      {
        id: 'contact_pref',
        type: 'select',
        title: 'Wie möchtest du deine Analyse erhalten?',
        key: 'kanal_praeferenz',
        options: [
          { value: 'wa', label: 'Direkt per WhatsApp', desc: 'Schnell, unkompliziert & digital' },
          { value: 'email', label: 'Klassisch per E-Mail', desc: 'Ausführliches PDF-Dokument' },
          { value: 'both', label: 'Beides', desc: 'Maximale Flexibilität für dich' }
        ]
      },
      {
        id: 'lead_form',
        type: 'form',
        title: 'Wohin dürfen wir deine Auswertung senden?',
        subtitle: 'Deine Daten werden verschlüsselt übertragen und absolut vertraulich behandelt.'
      },
      {
        id: 'success',
        type: 'success',
        title: 'Anfrage erfolgreich übermittelt!',
        subtitle: 'Wir erstellen jetzt deine individuelle Auswertung.'
      }
    ];

    // State Management
    let currentStepIndex = 0;
    const userAnswers = {};

    // DOM-Elemente
    const container = document.getElementById('funnel-container');
    const progContainer = document.getElementById('progress-container');
    const progBar = document.getElementById('progress-bar');
    const badgeCount = document.getElementById('badge-count');

    // 3. Funnel Engine (Rendert die Schritte anhand des Typs)
    function renderStep() {
      const step = FLOW_STEPS[currentStepIndex];
      
      // Animations-Reset
      container.classList.remove('step-enter');
      void container.offsetWidth; // Trigger Reflow
      container.classList.add('step-enter');

      // Progress Bar steuern
      if (currentStepIndex === 0 || currentStepIndex === FLOW_STEPS.length - 1) {
        progContainer.classList.add('hidden');
      } else {
        progContainer.classList.remove('hidden');
        const pct = ((currentStepIndex) / (FLOW_STEPS.length - 2)) * 100;
        progBar.style.width = `${pct}%`;
      }

      // Render-Logik nach Typ
      if (step.type === 'start') {
        container.innerHTML = `
          <div class="text-center py-6">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brandAccent/10 text-brandAccent mb-6">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight mb-3">${step.title}</h1>
            <p class="text-white/70 mb-8 max-w-md mx-auto leading-relaxed">${step.subtitle}</p>
            <button id="btn-start" class="w-full bg-brandButton hover:bg-brandButton/90 active:scale-[0.99] text-white font-bold py-4 px-6 rounded-xl transition-all shadow-lg shadow-brandButton/20 text-md">
              ${step.buttonText}
            </button>
          </div>
        `;
        document.getElementById('btn-start').addEventListener('click', goNext);
      } 
      
      else if (step.type === 'select') {
        let optionsHtml = step.options.map((opt, idx) => `
          <label class="group relative flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl cursor-pointer transition-all duration-200 focus-within:ring-2 focus-within:ring-brandAccent">
            <input type="radio" name="${step.key}" value="${opt.value}" class="peer sr-only" ${idx === 0 ? 'checked' : ''}>
            <div class="flex-1 pr-4">
              <p class="font-semibold text-white group-hover:text-brandAccent transition-colors">${opt.label}</p>
              <p class="text-xs text-white/50 mt-0.5">${opt.desc}</p>
            </div>
            <div class="w-5 h-5 rounded-full border-2 border-white/30 flex items-center justify-center peer-checked:border-brandAccent peer-checked:bg-brandAccent transition-all">
              <div class="w-2 h-2 rounded-full bg-brandDark opacity-0 peer-checked:opacity-100 transition-opacity"></div>
            </div>
          </label>
        `).join('');

        container.innerHTML = `
          <div>
            <span class="text-xs font-bold tracking-widest text-brandAccent uppercase">Schritt ${currentStepIndex} von ${FLOW_STEPS.length - 2}</span>
            <h2 class="text-2xl font-bold mt-1 mb-6">${step.title}</h2>
            <form id="step-form" class="space-y-3">
              ${optionsHtml}
            </form>
            <div class="flex items-center space-x-3 mt-8">
              <button id="btn-back" class="px-5 py-3 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 text-white/80 transition-all text-sm font-semibold">Zurück</button>
              <button id="btn-next" class="flex-1 py-3 bg-brandButton hover:bg-brandButton/90 text-white font-bold rounded-xl transition-all text-sm shadow-md">Weiter</button>
            </div>
          </div>
        `;

        document.getElementById('btn-back').addEventListener('click', goBack);
        document.getElementById('btn-next').addEventListener('click', () => {
          const selected = document.querySelector(`input[name="${step.key}"]:checked`).value;
          userAnswers[step.key] = selected;
          goNext();
        });
      } 
      
      else if (step.type === 'form') {
        container.innerHTML = `
          <div>
            <span class="text-xs font-bold tracking-widest text-brandAccent uppercase">Fast geschafft</span>
            <h2 class="text-2xl font-bold mt-1 mb-2">${step.title}</h2>
            <p class="text-sm text-white/60 mb-6">${step.subtitle}</p>
            
            <form id="lead-submit-form" class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-white/50 uppercase tracking-wider mb-1">Vollständiger Name</label>
                <input type="text" id="inp-name" required placeholder="z.B. Max Mustermann" class="w-full bg-white/5 border border-white/10 focus:border-brandAccent focus:ring-1 focus:ring-brandAccent rounded-xl px-4 py-3 text-white placeholder-white/20 outline-none transition-all">
              </div>
              <div>
                <label class="block text-xs font-semibold text-white/50 uppercase tracking-wider mb-1">Mobilnummer (für WhatsApp-Versand)</label>
                <input type="tel" id="inp-phone" required placeholder="z.B. 0176 12345678" class="w-full bg-white/5 border border-white/10 focus:border-brandAccent focus:ring-1 focus:ring-brandAccent rounded-xl px-4 py-3 text-white placeholder-white/20 outline-none transition-all">
              </div>
              <div>
                <label class="block text-xs font-semibold text-white/50 uppercase tracking-wider mb-1">E-Mail-Adresse</label>
                <input type="email" id="inp-email" required placeholder="name@beispiel.de" class="w-full bg-white/5 border border-white/10 focus:border-brandAccent focus:ring-1 focus:ring-brandAccent rounded-xl px-4 py-3 text-white placeholder-white/20 outline-none transition-all">
              </div>
              
              <div id="error-message" class="hidden text-red-400 text-xs bg-red-500/10 border border-red-500/20 p-3 rounded-xl"></div>

              <div class="flex items-center space-x-3 mt-6">
                <button type="button" id="btn-back" class="px-5 py-3 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 text-white/80 transition-all text-sm font-semibold">Zurück</button>
                <button type="submit" id="btn-submit" class="flex-1 py-3 bg-brandAccent hover:bg-brandAccent/90 text-brandDark font-bold rounded-xl transition-all text-sm shadow-lg shadow-brandAccent/10 flex justify-center items-center">
                  <span id="btn-submit-text">Kostenlose Analyse anfordern</span>
                </button>
              </div>
            </form>
          </div>
        `;

        document.getElementById('btn-back').addEventListener('click', goBack);
        document.getElementById('lead-submit-form').addEventListener('submit', handleLeadSubmission);
      } 
      
      else if (step.type === 'success') {
        const hasWhatsApp = userAnswers['kanal_praeferenz'] === 'wa' || userAnswers['kanal_praeferenz'] === 'both';
        
        container.innerHTML = `
          <div class="text-center py-6">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-500/10 text-emerald-400 mb-6">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h2 class="text-3xl font-extrabold tracking-tight mb-2">${step.title}</h2>
            <p class="text-white/70 mb-8 max-w-sm mx-auto leading-relaxed">${step.subtitle}</p>
            
            ${hasWhatsApp ? `
              <div class="bg-white/5 border border-white/10 rounded-2xl p-4 mb-4">
                <p class="text-xs text-white/60 mb-3">Klicke auf den Button, um den sicheren Chat direkt zu starten:</p>
                <button id="btn-wa-open" class="w-full bg-[#25D366] hover:bg-[#20ba5a] text-brandDark font-bold py-3.5 px-6 rounded-xl transition-all flex items-center justify-center space-x-2 text-sm">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.713-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.966C16.528 1.975 14.069 1.95 12.01 1.95c-5.443 0-9.866 4.372-9.87 9.802 0 1.689.46 3.336 1.33 4.796L2.466 21.65l5.181-1.336z"/></svg>
                  <span>WhatsApp Chat starten</span>
                </button>
              </div>
            ` : ''}
            
            <button id="btn-restart" class="text-xs text-white/40 hover:text-brandAccent underline transition-colors">Neue Analyse starten</button>
          </div>
        `;

        if (hasWhatsApp) {
          document.getElementById('btn-wa-open').addEventListener('click', () => {
            const msg = encodeURIComponent(`🔔 Neue PKV-Anfrage von ${userAnswers.name}\n\n• Status: ${userAnswers.berufsstatus}\n• Beihilfe: ${userAnswers.beihilfe_anspruch}`);
            window.open(`https://wa.me/${CONFIG.whatsappNumber}?text=${msg}`, '_blank');
          });
        }
        document.getElementById('btn-restart').addEventListener('click', restartFunnel);
      }
    }

    // Navigations-Funktionen
    function goNext() { if (currentStepIndex < FLOW_STEPS.length - 1) { currentStepIndex++; renderStep(); } }
    function goBack() { if (currentStepIndex > 0) { currentStepIndex--; renderStep(); } }
    function restartFunnel() { currentStepIndex = 0; Object.keys(userAnswers).forEach(k => delete userAnswers[k]); renderStep(); }

    // 4. Sicheres Backend-Submission-Handling
    async function handleLeadSubmission(e) {
      e.preventDefault();
      
      const btn = document.getElementById('btn-submit');
      const btnText = document.getElementById('btn-submit-text');
      const errBox = document.getElementById('error-message');

      // Formulardaten auslesen
      userAnswers.name = document.getElementById('inp-name').value.trim();
      userAnswers.phone = document.getElementById('inp-phone').value.trim();
      userAnswers.email = document.getElementById('inp-email').value.trim();

      // UI blockieren (Verhindert Doppel-Submissions)
      btn.disabled = true;
      btn.classList.add('opacity-50', 'cursor-not-allowed');
      btnText.innerText = "Daten werden verschlüsselt...";
      errBox.classList.add('hidden');

      try {
        const response = await fetch(CONFIG.webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...userAnswers,
            timestamp: new Date().toISOString(),
            source: 'pkv_funnel_v2'
          })
        });

        if (!response.ok) throw new Error('Server-Antwort war nicht fehlerfrei.');

        // Lokales Tracking für das Badge unten rechts
        trackLeadLocal();
        
        // Erst bei echtem Erfolg zum Success-Screen wechseln
        goNext();

      } catch (err) {
        console.error('Submission Fehler:', err);
        // Fehler anzeigen & Button wieder freigeben
        errBox.innerText = "Verbindungsfehler. Deine Daten konnten nicht übertragen werden. Bitte versuche es noch einmal.";
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
        btnText.innerText = "Kostenlose Analyse anfordern";
      }
    }

    // 5. Minimalistisches lokales Lead-Tracking
    function trackLeadLocal() {
      const currentLeads = parseInt(localStorage.getItem('bh_leads_count') || '0', 10);
      const newCount = currentLeads + 1;
      localStorage.setItem('bh_leads_count', newCount);
      updateBadge();
    }

    function updateBadge() {
      badgeCount.innerText = localStorage.getItem('bh_leads_count') || '0';
    }

    // Init-Start
    renderStep();
    updateBadge();
  </script>
</body>
</html>
